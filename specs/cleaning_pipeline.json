{
  "pipeline_version": "0.2.0",
  "inputs": [
    "data/extracted/pdf_extracted_records.csv",
    "data/extracted/web_extracted_records.csv"
  ],
  "output": "data/processed/dataset.csv",
  "steps": [
    {
      "step_id": "merge_sources",
      "operation": "concatenate",
      "description": "Merge tables extracted from PDF and web sources into a single interim file.",
      "input_files": [
        "data/extracted/pdf_extracted_records.csv",
        "data/extracted/web_extracted_records.csv"
      ],
      "output_file": "data/interim/merged_records.csv"
    },
    {
      "step_id": "standardize_smiles",
      "operation": "smiles_cleanup",
      "description": "Remove invalid characters and whitespaces from polymer_SMILES, catalyst_smiles, and crosslinker strings.",
      "fields": ["polymer_SMILES", "catalyst_smiles", "crosslinker"],
      "output_file": "data/interim/merged_records.csv"
    },
    {
      "step_id": "standardize_missing_values",
      "operation": "missing_value_cleanup",
      "description": "Replace empty strings, hyphens, and NA markers with standard null values for pandas across all physical metrics.",
      "fields": [
        "temperature_C", "relaxation_time_s", "normalized_stress", 
        "storage_modulus_Pa", "log_viscosity", "normalized_inverse_temperature", 
        "time_s", "tan_delta", "normalized_fluorescence_intensity", "domain_distance_nm"
      ],
      "output_file": "data/interim/merged_records.csv"
    },
    {
      "step_id": "validate_schema",
      "operation": "validation",
      "description": "Validate the final dataset against the specs/dataset_schema.json specification.",
      "input_files": ["data/processed/dataset.csv"],
      "output_file": "reports/validation_report.md"
    }
  ]
}