{
  "validation_version": "0.2.0",
  "rules": [
    {
      "rule_id": "dataset_csv_exists",
      "target": "data/processed/dataset.csv",
      "rule_type": "file_exists",
      "severity": "error",
      "description": "The final processed dataset file must physically exist."
    },
    {
      "rule_id": "polymer_smiles_not_null",
      "target": "polymer_SMILES",
      "rule_type": "not_null",
      "severity": "error",
      "description": "The polymer_SMILES structure field cannot be empty."
    },
    {
      "rule_id": "dynamic_bond_type_not_null",
      "target": "dynamic_bond_type",
      "rule_type": "not_null",
      "severity": "error",
      "description": "The dynamic_bond_type field must be specified for every record."
    },
    {
      "rule_id": "temperature_numeric_or_null",
      "target": "temperature_C",
      "rule_type": "numeric_or_null",
      "severity": "error",
      "description": "Temperature must be a numeric value or null."
    },
    {
      "rule_id": "relaxation_time_positive",
      "target": "relaxation_time_s",
      "rule_type": "positive_numeric_or_null",
      "severity": "error",
      "description": "Relaxation time (if specified) must be a strictly positive number."
    }
  ]
}